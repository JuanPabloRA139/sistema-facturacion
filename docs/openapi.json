{
  "openapi": "3.0.3",
  "info": {
    "title": "Facturación y servicios",
    "version": "1.1.0",
    "description": "API detrás de API Gateway. Requiere un token de acceso de Cognito. Los importes se expresan en centavos de MXN y las tasas en puntos base. Las solicitudes usan objetos JSON UTF-8 de hasta 32768 bytes, con nombres de campo únicos y cantidades enteras. Los textos se validan tras recortar espacios en sus extremos. Se rechazan los caracteres de control."
  },
  "security": [
    {
      "Cognito": []
    }
  ],
  "components": {
    "securitySchemes": {
      "Cognito": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorGateway": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EstadoFactura": {
        "type": "string",
        "enum": [
          "emitida",
          "parcial",
          "pagada",
          "cancelada"
        ]
      },
      "Rol": {
        "type": "string",
        "enum": [
          "operador",
          "administrador",
          "auditor"
        ]
      },
      "Catalogo": {
        "type": "object",
        "required": [
          "id",
          "nombre"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "nombre": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Servicio": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "precio"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "nombre": {
            "type": "string"
          },
          "precio": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          }
        },
        "additionalProperties": false
      },
      "ResumenFactura": {
        "type": "object",
        "required": [
          "id",
          "fecha",
          "total",
          "estado"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoFactura"
          }
        },
        "additionalProperties": false
      },
      "Panel": {
        "type": "object",
        "required": [
          "tasas",
          "rol",
          "usuario",
          "servicios",
          "caracteristicas",
          "clientes",
          "facturas"
        ],
        "properties": {
          "tasas": {
            "type": "object",
            "required": [
              "iva",
              "retencion"
            ],
            "properties": {
              "iva": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "retencion": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "additionalProperties": false
          },
          "rol": {
            "$ref": "#/components/schemas/Rol"
          },
          "usuario": {
            "type": "string"
          },
          "servicios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Servicio"
            },
            "maxItems": 500
          },
          "caracteristicas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Catalogo"
            },
            "maxItems": 500
          },
          "clientes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Catalogo"
            },
            "maxItems": 500
          },
          "facturas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResumenFactura"
            },
            "maxItems": 100
          }
        },
        "additionalProperties": false
      },
      "ConceptoComprobante": {
        "type": "object",
        "required": [
          "nombre",
          "cantidad",
          "precio"
        ],
        "properties": {
          "nombre": {
            "type": "string"
          },
          "cantidad": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "precio": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          }
        },
        "additionalProperties": false
      },
      "Comprobante": {
        "type": "object",
        "required": [
          "id",
          "fecha",
          "cliente_nombre",
          "rfc",
          "estado",
          "subtotal",
          "descuento",
          "iva",
          "retencion",
          "total",
          "pagado",
          "saldo",
          "conceptos"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "cliente_nombre": {
            "type": "string"
          },
          "rfc": {
            "type": "string"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoFactura"
          },
          "subtotal": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "descuento": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "iva": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "retencion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "pagado": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "saldo": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "conceptos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConceptoComprobante"
            },
            "maxItems": 30,
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "ComprobantePago": {
        "type": "object",
        "required": [
          "id",
          "fecha",
          "cliente_nombre",
          "rfc",
          "estado",
          "subtotal",
          "descuento",
          "iva",
          "retencion",
          "total",
          "pagado",
          "saldo",
          "conceptos",
          "pago_duplicado"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "cliente_nombre": {
            "type": "string"
          },
          "rfc": {
            "type": "string"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoFactura"
          },
          "subtotal": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "descuento": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "iva": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "retencion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "pagado": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "saldo": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          },
          "conceptos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConceptoComprobante"
            },
            "maxItems": 30,
            "minItems": 1
          },
          "pago_duplicado": {
            "type": "boolean",
            "description": "Verdadero si ya existía el mismo pago en este folio."
          }
        },
        "additionalProperties": false
      },
      "FilaCartera": {
        "type": "object",
        "required": [
          "folio",
          "vence",
          "dias_vencidos",
          "saldo"
        ],
        "properties": {
          "folio": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "vence": {
            "type": "string",
            "format": "date"
          },
          "dias_vencidos": {
            "type": "integer",
            "minimum": 0
          },
          "saldo": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Centavos de MXN."
          }
        },
        "additionalProperties": false
      },
      "FilasCartera": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/FilaCartera"
        },
        "maxItems": 200
      },
      "CursorCartera": {
        "type": "object",
        "required": [
          "vence",
          "folio"
        ],
        "properties": {
          "vence": {
            "type": "string",
            "format": "date"
          },
          "folio": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "PaginaCartera": {
        "type": "object",
        "required": [
          "filas",
          "siguiente"
        ],
        "properties": {
          "filas": {
            "$ref": "#/components/schemas/FilasCartera"
          },
          "siguiente": {
            "type": "object",
            "required": [
              "vence",
              "folio"
            ],
            "properties": {
              "vence": {
                "type": "string",
                "format": "date"
              },
              "folio": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false,
            "nullable": true,
            "description": "Clave de la última fila devuelta cuando quedan filas. null indica el final."
          }
        },
        "additionalProperties": false
      },
      "EventoAuditoria": {
        "type": "object",
        "required": [
          "fecha",
          "usuario",
          "accion",
          "entidad",
          "detalle"
        ],
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "usuario": {
            "type": "string"
          },
          "accion": {
            "type": "string"
          },
          "entidad": {
            "type": "string"
          },
          "detalle": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "EntradaInvalida": {
        "description": "El cuerpo, la acción o sus valores no cumplen las reglas.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "SesionRequerida": {
        "description": "Falta un token de acceso válido.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/ErrorGateway"
                }
              ]
            }
          }
        }
      },
      "Prohibido": {
        "description": "El directorio o el rol impide la operación.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/ErrorGateway"
                }
              ]
            }
          }
        }
      },
      "FueraDeAlcance": {
        "description": "Registro inexistente o fuera del ámbito del usuario.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/ErrorGateway"
                }
              ]
            }
          }
        }
      },
      "MetodoNoPermitido": {
        "description": "El controlador requiere POST.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflicto": {
        "description": "La operación entra en conflicto con el estado actual.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MuyGrande": {
        "description": "El cuerpo JSON supera el límite admitido por el controlador.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TipoDeContenido": {
        "description": "El controlador requiere Content-Type application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "LimiteDePeticiones": {
        "description": "API Gateway limitó la tasa de solicitudes.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorGateway"
            }
          }
        }
      },
      "ServicioOcupado": {
        "description": "El servicio o una dependencia no está disponible.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/inicio": {
      "post": {
        "summary": "Panel inicial",
        "operationId": "inicio",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Panel"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "401": {
            "$ref": "#/components/responses/SesionRequerida"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/FueraDeAlcance"
          },
          "405": {
            "$ref": "#/components/responses/MetodoNoPermitido"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          },
          "413": {
            "$ref": "#/components/responses/MuyGrande"
          },
          "415": {
            "$ref": "#/components/responses/TipoDeContenido"
          },
          "429": {
            "$ref": "#/components/responses/LimiteDePeticiones"
          },
          "503": {
            "$ref": "#/components/responses/ServicioOcupado"
          }
        },
        "description": "Todos los roles."
      }
    },
    "/api/cliente": {
      "post": {
        "summary": "Alta de cliente",
        "operationId": "cliente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "rfc"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "rfc": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 13,
                    "description": "Se quitan los espacios de los extremos y se convierte a mayúsculas. Se revisan la estructura del RFC y la fecha de calendario.",
                    "example": "ZETA000229AB1"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cliente"
                  ],
                  "properties": {
                    "cliente": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "401": {
            "$ref": "#/components/responses/SesionRequerida"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/FueraDeAlcance"
          },
          "405": {
            "$ref": "#/components/responses/MetodoNoPermitido"
          },
          "409": {
            "$ref": "#/components/responses/Conflicto"
          },
          "413": {
            "$ref": "#/components/responses/MuyGrande"
          },
          "415": {
            "$ref": "#/components/responses/TipoDeContenido"
          },
          "429": {
            "$ref": "#/components/responses/LimiteDePeticiones"
          },
          "503": {
            "$ref": "#/components/responses/ServicioOcupado"
          }
        },
        "description": "Operador y administrador."
      }
    },
    "/api/emitir": {
      "post": {
        "summary": "Emisión con clave de reintento",
        "operationId": "emitir",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cliente",
                  "clave",
                  "conceptos"
                ],
                "properties": {
                  "cliente": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "clave": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Reutiliza la misma clave al reintentar la misma factura.",
                    "maxLength": 80
                  },
                  "conceptos": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "required": [
                        "servicio",
                        "cantidad"
                      ],
                      "properties": {
                        "servicio": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000000
                        },
                        "cantidad": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 999
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "total_esperado": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000000000000,
                    "description": "Total que vio el operador, en centavos de MXN. El servidor calcula el importe con sus propias tarifas."
                  }
                },
                "additionalProperties": false
              },
              "examples": {
                "importeConfirmado": {
                  "summary": "El servicio suma $117.60 y el operador confirma $117.60",
                  "value": {
                    "cliente": 1,
                    "clave": "a4a835eb-0524-4271-b663-d14c132a70e3",
                    "conceptos": [
                      {
                        "servicio": 1,
                        "cantidad": 1
                      }
                    ],
                    "total_esperado": 11760
                  }
                },
                "importeDistinto": {
                  "summary": "El servicio suma $117.60 y el operador vio $117.59",
                  "value": {
                    "cliente": 1,
                    "clave": "a4a835eb-0524-4271-b663-d14c132a70e3",
                    "conceptos": [
                      {
                        "servicio": 1,
                        "cantidad": 1
                      }
                    ],
                    "total_esperado": 11759
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comprobante"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/EntradaInvalida"
          },
          "401": {
            "$ref": "#/components/responses/SesionRequerida"
          },
          "403": {
            "$ref": "#/components/responses/Prohibido"
          },
          "404": {
            "$ref": "#/components/responses/FueraDeAlcance"
          },
          "405": {
            "$ref": "#/components/responses/MetodoNoPermitido"
          },
          "409": {
            "description": "Conflicto con el estado actual. Si cambió el total, la operación se revierte y el operador debe revisar el resumen antes de volver a confirmar.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "El total cambió. Revisa el resumen y confirma nuevamente."
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/MuyGrande"
          },
          "415": {
            "$ref": "#/components/responses/TipoDeContenido"
          },
          "429": {
            "$ref": "#/components/responses/LimiteDePeticiones"
          },
          "503": {
            "$ref": "#/components/responses/ServicioOcupado"
          }
        },
        "description": "Operador y administrador. La misma clave permite reintentar una emisión."
      }
    },
    "/api/comprobante": {
      "post": {
        "summary": "Comprobante del folio",
        "operationId": "comprobante",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "factura"
                ],
                "properties": {
                  "factura": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operación completada.",
            "content": {
              "application/json": {
